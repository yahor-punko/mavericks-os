#!/usr/bin/env bash
# Mavericks pre-commit hook — validates artifact sync before each commit.
#
# Exit codes from mavp-validator.js:
#   0 = healthy   → silent, commit proceeds
#   1 = drifting  → warning printed, commit proceeds
#   2 = repair required → commit BLOCKED

set -euo pipefail

# Locate the validator: prefer THIS repo's own scripts/ when it contains
# mavp-validator.js (T-430 — a self-hosting mavericks checkout must run its
# own current code, not a possibly-stale sibling installation), then
# MAVERICKS_SCRIPTS env var, then MAVERICKS_HOME, then ~/.mavericks
# (canonical), then ~/Documents/mavericks (legacy). Adopter/direct-reference
# repos have no local scripts/mavp-validator.js, so they fall through to the
# existing chain unchanged.
if [[ -f "scripts/mavp-validator.js" ]]; then
  MAVERICKS_SCRIPT_DIR="scripts"
elif [ -n "${MAVERICKS_HOME:-}" ]; then
  MAVERICKS_ROOT="$MAVERICKS_HOME"
  MAVERICKS_SCRIPT_DIR="${MAVERICKS_SCRIPTS:-$MAVERICKS_ROOT/scripts}"
elif [ -d "$HOME/.mavericks" ]; then
  MAVERICKS_ROOT="$HOME/.mavericks"
  MAVERICKS_SCRIPT_DIR="${MAVERICKS_SCRIPTS:-$MAVERICKS_ROOT/scripts}"
else
  MAVERICKS_ROOT="$HOME/Documents/mavericks"
  MAVERICKS_SCRIPT_DIR="${MAVERICKS_SCRIPTS:-$MAVERICKS_ROOT/scripts}"
fi
VALIDATOR="$MAVERICKS_SCRIPT_DIR/mavp-validator.js"

if [[ ! -f "$VALIDATOR" ]]; then
  echo "WARNING: Mavericks validator not found at $VALIDATOR — skipping pre-commit check."
  echo "Set MAVERICKS_HOME if mavericks is not at ~/.mavericks or the legacy ~/Documents/mavericks."
  exit 0
fi

EXIT_CODE=0
node "$VALIDATOR" || EXIT_CODE=$?

if [[ $EXIT_CODE -eq 2 ]]; then
  echo ""
  echo "COMMIT BLOCKED: artifact repair required. Run: ./scripts/mavp-operator --validate"
  exit 1
elif [[ $EXIT_CODE -eq 1 ]]; then
  echo ""
  echo "WARNING: artifact drift detected (exit 1). Commit proceeding — fix drift soon."
fi

# Commit-time publish-manifest backstop (T-401). No-op when the project has
# no scripts/check-publish-manifest.js (adopter repos, public mirror). The
# script's own --if-canonical flag further gates enforcement to the
# canonical private repo, so this is safe to run unconditionally wherever
# the file happens to exist.
if [[ -f "scripts/check-publish-manifest.js" ]]; then
  MANIFEST_EXIT=0
  node scripts/check-publish-manifest.js --if-canonical || MANIFEST_EXIT=$?
  if [[ $MANIFEST_EXIT -ne 0 ]]; then
    echo ""
    echo "COMMIT BLOCKED: unclassified file(s) in scripts/publish-manifest.json. Run: node scripts/check-publish-manifest.js"
    exit 1
  fi
fi

# Frozen-changelog-section guard (T-499, enforcing the rule codified in T-498
# / docs/PUBLIC_RELEASE_STRATEGY.md §5). No-op when the project has no
# scripts/check-changelog-frozen.js (adopter repos, public mirror — a
# CHANGELOG.md is not framework-managed there). The script's own
# --if-canonical flag further gates enforcement to the canonical private
# repo, same mechanism as the publish-manifest backstop above, so this is
# safe to run unconditionally wherever the file happens to exist.
if [[ -f "scripts/check-changelog-frozen.js" ]]; then
  CHANGELOG_EXIT=0
  node scripts/check-changelog-frozen.js --if-canonical || CHANGELOG_EXIT=$?
  if [[ $CHANGELOG_EXIT -ne 0 ]]; then
    echo ""
    echo "COMMIT BLOCKED: staged CHANGELOG.md edit touches an already-released section (see message above)."
    exit 1
  fi
fi

exit 0
