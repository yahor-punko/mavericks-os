#!/usr/bin/env bash
# Mavericks pre-commit hook — validates artifact sync before each commit.
#
# Exit codes from mavp-validator.js:
#   0 = healthy   → silent, commit proceeds
#   1 = drifting  → warning printed, commit proceeds
#   2 = repair required → commit BLOCKED

set -euo pipefail

# Locate the validator: prefer MAVERICKS_SCRIPTS env var, then MAVERICKS_HOME,
# then ~/.mavericks (canonical), then ~/Documents/mavericks (legacy).
if [ -n "${MAVERICKS_HOME:-}" ]; then
  MAVERICKS_ROOT="$MAVERICKS_HOME"
elif [ -d "$HOME/.mavericks" ]; then
  MAVERICKS_ROOT="$HOME/.mavericks"
else
  MAVERICKS_ROOT="$HOME/Documents/mavericks"
fi
MAVERICKS_SCRIPT_DIR="${MAVERICKS_SCRIPTS:-$MAVERICKS_ROOT/scripts}"
VALIDATOR="$MAVERICKS_SCRIPT_DIR/mavp-validator.js"

if [[ ! -f "$VALIDATOR" ]]; then
  echo "WARNING: Mavericks validator not found at $VALIDATOR — skipping pre-commit check."
  echo "Set MAVERICKS_HOME if mavericks is not at ~/.mavericks or the legacy ~/Documents/mavericks."
  exit 0
fi

EXIT_CODE=0
node "$VALIDATOR" || EXIT_CODE=$?

if [[ $EXIT_CODE -eq 2 ]]; then
  echo ""
  echo "COMMIT BLOCKED: artifact repair required. Run: node scripts/mavp-validator.js"
  exit 1
elif [[ $EXIT_CODE -eq 1 ]]; then
  echo ""
  echo "WARNING: artifact drift detected (exit 1). Commit proceeding — fix drift soon."
  exit 0
fi

exit 0
