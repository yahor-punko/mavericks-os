# Generic ignores
.DS_Store
node_modules/
dist/
coverage/
.tmp/

# Claude Code local settings
.claude/settings.local.json
.claude/mcp.json
.claude/worktrees/

# Shared project settings (T-529) — untracked deliberately: the Claude Code
# permission layer appends every approved Bash command string to this file's
# permissions.allow array verbatim, so its live content is an append-only log
# of arbitrary operator commands that can carry private project names and
# absolute home paths (T-516). git rm --cached removed it from the index;
# it stays on disk for Claude Code and permission-mode resolution to read.
# Fresh-clone note: a fresh clone has no .claude/settings.json — seed one by
# copying templates/SETTINGS_TEMPLATE.json to .claude/settings.json.
.claude/settings.json

# Handoff context file (single-use, not committed)
HANDOFF.md
.mavp-hook-ts

# Persisted runtime permission_mode (machine/session state, not committed)
.mavp/permission-mode

# Task context prefetch bundles (regenerated at registration/update time, not committed)
.mavp/context/

# Assembled-suite receipt (T-587) — machine-local evidence that the shipped
# suite ran green in a mirror-shaped assembled tree at a specific commit.
# Written by scripts/check-assembled-suite.js, read by the publish preflight in
# scripts/mavp-publish-build.js. Must stay untracked AND ignored: an ignored
# file keeps `git status --porcelain` clean, which both of those scripts require.
.mavp/assembled-suite-receipt.json

# Session-transcript archive (opt-in, --transcript-archive) — privacy-sensitive
# full session content, local-disk only, never git-tracked
.mavp/transcripts/
